# Copy this file to .env and adjust values if needed.
# No API keys are required — the LLM runs locally through Ollama.

# Vector store
CHROMA_DIR=./chroma_data
COLLECTION_NAME=documents

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking
CHUNK_STRATEGY=recursive
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Semantic chunking (only used when CHUNK_STRATEGY=semantic)
SEMANTIC_THRESHOLD=0.5

# Retrieval
TOP_K=4

# Reranking (cross-encoder over the bi-encoder candidates)
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=12

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=120

# CORS — comma-separated list of origins allowed to call this service.
ALLOWED_ORIGINS=http://localhost:8080

# Logging
LOG_LEVEL=INFO
JSON_LOGS=false

# Ollama generation retries (exponential backoff)
OLLAMA_MAX_RETRIES=2
OLLAMA_BASE_BACKOFF_SECONDS=2.0
